# Canonical production origin. Drives metadataBase (og:image / canonical),
# JSON-LD, app/robots.ts and app/sitemap.ts in lib/site-config.ts.
# Rules: include the protocol, no trailing slash.
#
# If unset, site-config falls back to Vercel's auto-injected production URL
# (NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL), then to http://localhost:3000
# for local dev. Set this explicitly on your host to pin the canonical domain.
#
# Currently deployed on the Vercel subdomain:
NEXT_PUBLIC_SITE_URL=https://li-ko-chuang.vercel.app
# Once the custom domain's DNS is live, switch to:
# NEXT_PUBLIC_SITE_URL=https://likochuang.com
